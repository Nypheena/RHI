<Window x:Class="RenoDXdbEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RenoDXdb Editor" Height="700" Width="1100" MinWidth="800" MinHeight="500"
        Background="#1A1A2E" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#E0E0F0"/>
            <Setter Property="SelectionBrush" Value="#5555AA"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333355"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#555577"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444466"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2255AA"/>
            <Setter Property="BorderBrush" Value="#3366CC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3366BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#114488"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#882222"/>
            <Setter Property="BorderBrush" Value="#AA3333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#AA3333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="▾" Foreground="#AAAACC"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                            <ToggleButton Grid.ColumnSpan="2" Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="#252540" BorderBrush="#444466" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333366"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2255AA"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#14142A"/>
            <Setter Property="BorderBrush" Value="#333355"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2255AA"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252550"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="#14142A" BorderBrush="#333355" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open JSON" Click="OpenFile_Click" Padding="12,5"/>
                <Button Content="Save" Click="SaveFile_Click" Style="{StaticResource AccentButton}" Padding="12,5" IsEnabled="{Binding HasFile}" Margin="8,0,0,0"/>
                <Button Content="Save As" Click="SaveFileAs_Click" Padding="12,5" IsEnabled="{Binding HasFile}" Margin="8,0,0,0"/>
                <Separator Width="1" Background="#444466" Margin="12,0"/>
                <Button Content="+ New Game" Click="NewGame_Click" Style="{StaticResource AccentButton}" IsEnabled="{Binding HasFile}"/>
                <Button Content="Delete" Click="DeleteGame_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding HasSelection}" Margin="8,0,0,0"/>
                <Separator Width="1" Background="#444466" Margin="12,0"/>
                <!-- Search -->
                <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBox_TextChanged"
                         Background="#252540" Foreground="#E0E0F0" BorderBrush="#444466"
                         ToolTip="Filter games"/>
                <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="#AAAACC" Margin="4,0,0,0"/>
                <!-- Count -->
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Foreground="#AAAACC" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: game list -->
            <ListBox x:Name="GameList" Grid.Column="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="GameList_SelectionChanged"
                     BorderThickness="0,0,1,0" BorderBrush="#333355"
                     DisplayMemberPath="DisplayName"/>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#333355" Cursor="SizeWE"/>

            <!-- Right: editor -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                <StackPanel x:Name="EditorPanel" IsEnabled="{Binding HasSelection}" Width="Auto">

                    <TextBlock Text="Game Details" FontSize="16" FontWeight="Bold"
                               Foreground="#8888FF" Margin="0,0,0,16"/>

                    <!-- Name -->
                    <Label Content="Game Name *"/>
                    <TextBox x:Name="NameBox" TextChanged="Field_Changed"/>

                    <!-- Status -->
                    <Label Content="Status *" Margin="0,10,0,0"/>
                    <ComboBox x:Name="StatusCombo" SelectionChanged="Field_Changed">
                        <ComboBoxItem Content="Done"/>
                        <ComboBoxItem Content="WIP"/>
                    </ComboBox>

                    <!-- Author -->
                    <Label Content="Author *" Margin="0,10,0,0"/>
                    <TextBox x:Name="AuthorBox" TextChanged="Field_Changed"/>

                    <!-- Snapshot URL 64 -->
                    <Label Content="Snapshot URL (64-bit .addon64)" Margin="0,10,0,0"/>
                    <TextBox x:Name="SnapshotUrlBox" TextChanged="Field_Changed"/>

                    <!-- Snapshot URL 32 -->
                    <Label Content="Snapshot URL (32-bit .addon32)" Margin="0,10,0,0"/>
                    <TextBox x:Name="SnapshotUrl32Box" TextChanged="Field_Changed"/>

                    <!-- Nexus URL -->
                    <Label Content="Nexus / GameBanana URL" Margin="0,10,0,0"/>
                    <TextBox x:Name="NexusUrlBox" TextChanged="Field_Changed"/>

                    <!-- Discord URL -->
                    <Label Content="Discord URL" Margin="0,10,0,0"/>
                    <TextBox x:Name="DiscordUrlBox" TextChanged="Field_Changed"/>

                    <!-- Discussion URL -->
                    <Label Content="Discussion URL (GitHub Discussions)" Margin="0,10,0,0"/>
                    <TextBox x:Name="DiscussionUrlBox" TextChanged="Field_Changed"/>

                    <!-- Notes -->
                    <Label Content="Notes" Margin="0,10,0,0"/>
                    <TextBox x:Name="NotesBox" TextChanged="Field_Changed"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Save button -->
                    <Button Content="Apply Changes" Click="ApplyChanges_Click"
                            Style="{StaticResource AccentButton}"
                            Margin="0,20,0,0" HorizontalAlignment="Left"
                            Padding="16,7"/>

                    <TextBlock x:Name="StatusLabel" Foreground="#55CC77"
                               Margin="0,8,0,0" FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#0F0F1E" BorderBrush="#333355" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="StatusBar" Foreground="#8888AA" FontSize="11" Text="No file open — click Open JSON to get started"/>
        </Border>
    </Grid>
</Window>
